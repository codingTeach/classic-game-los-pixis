<!DOCTYPE html>
<html>
  <head>
    <title>PvZ Realistic Trio - A-Frame</title>
    <script src="https://aframe.io/releases/1.4.0/aframe.min.js"></script>
  </head>
  <body>
    <a-scene shadow="type: pcfsoft">
      <a-assets>
        <img id="dirt" src="https://cdn.pixabay.com/photo/2016/11/19/18/57/texture-1840784_960_720.jpg">
      </a-assets>

      <a-entity light="type: ambient; intensity: 0.4; color: #445"></a-entity>
      <a-entity light="type: spot; intensity: 1.5; castShadow: true; position: 0 10 5" target="#zombie-cono"></a-entity>

      <a-sky color="#050510"></a-sky>
      <a-plane position="0 0 0" rotation="-90 0 0" width="50" height="50" 
               material="src: #dirt; repeat: 15 15; roughness: 1" shadow="receive: true"></a-plane>

      <a-entity id="zombie-normal" position="-2.5 0 -5">
        <a-box position="0 1.1 0" width="0.5" height="0.9" depth="0.3" color="#4a3b2a" shadow>
            <a-box position="0 0.2 0.16" width="0.3" height="0.4" depth="0.05" color="#d1d1bd"></a-box>
            <a-box position="0 0.05 0.17" width="0.04" height="0.45" depth="0.05" color="#5a0000"></a-box>
        </a-box>

        <a-entity position="0 1.8 0.1">
          <a-sphere radius="0.28" color="#6b8e6d" material="roughness: 1"></a-sphere>
          <a-sphere position="-0.12 0.1 0.23" radius="0.09" color="#fff" material="emissive: #fff; emissiveIntensity: 0.1">
            <a-sphere position="0 0 0.08" radius="0.03" color="#000"></a-sphere>
          </a-sphere>
          <a-sphere position="0.12 0.05 0.23" radius="0.12" color="#fff">
            <a-sphere position="0 0 0.1" radius="0.04" color="#000"></a-sphere>
          </a-sphere>
          <a-box position="0 -0.2 0.1" width="0.35" height="0.2" depth="0.3" color="#557a57"></a-box>
        </a-entity>

        <a-box position="0.35 1.4 0.3" width="0.1" height="0.1" depth="0.7" color="#6b8e6d" rotation="5 10 0"></a-box>
        <a-box position="-0.35 1.3 0.3" width="0.1" height="0.1" depth="0.7" color="#6b8e6d" rotation="-5 -10 0"></a-box>
      </a-entity>

      <a-entity id="zombie-cono" position="0 0 -5">
        <a-box position="0 1.1 0" width="0.5" height="0.9" depth="0.3" color="#4a3b2a" shadow>
            <a-box position="0 0.2 0.16" width="0.3" height="0.4" depth="0.05" color="#d1d1bd"></a-box>
            <a-box position="0 0.05 0.17" width="0.04" height="0.45" depth="0.05" color="#5a0000"></a-box>
        </a-box>

        <a-entity position="0 1.8 0.1">
          <a-sphere radius="0.28" color="#6b8e6d"></a-sphere>
          <a-sphere position="-0.12 0.1 0.23" radius="0.09" color="#fff">
            <a-sphere position="0 0 0.08" radius="0.03" color="#000"></a-sphere>
          </a-sphere>
          <a-sphere position="0.12 0.05 0.23" radius="0.12" color="#fff">
            <a-sphere position="0 0 0.1" radius="0.04" color="#000"></a-sphere>
          </a-sphere>
          
          <a-cone position="0 0.45 0" radius-bottom="0.35" radius-top="0.02" height="0.8" 
                  color="#e65100" material="roughness: 0.6" rotation="10 0 0" shadow="cast: true"></a-cone>
          
          <a-box position="0 -0.2 0.1" width="0.35" height="0.2" depth="0.3" color="#557a57"></a-box>
        </a-entity>

        <a-box position="0.35 1.4 0.3" width="0.1" height="0.1" depth="0.7" color="#6b8e6d" rotation="5 10 0"></a-box>
        <a-box position="-0.35 1.3 0.3" width="0.1" height="0.1" depth="0.7" color="#6b8e6d" rotation="-5 -10 0"></a-box>
      </a-entity>

      <a-entity id="zombie-cubeta" position="2.5 0 -5">
        <a-box position="0 1.1 0" width="0.5" height="0.9" depth="0.3" color="#4a3b2a" shadow>
            <a-box position="0 0.2 0.16" width="0.3" height="0.4" depth="0.05" color="#d1d1bd"></a-box>
            <a-box position="0 0.05 0.17" width="0.04" height="0.45" depth="0.05" color="#5a0000"></a-box>
        </a-box>

        <a-entity position="0 1.8 0.1">
          <a-sphere radius="0.28" color="#6b8e6d"></a-sphere>
          <a-sphere position="-0.12 0.1 0.23" radius="0.09" color="#fff">
            <a-sphere position="0 0 0.08" radius="0.03" color="#000"></a-sphere>
          </a-sphere>
          <a-sphere position="0.12 0.05 0.23" radius="0.12" color="#fff">
            <a-sphere position="0 0 0.1" radius="0.04" color="#000"></a-sphere>
          </a-sphere>
          
          <a-cylinder position="0 0.35 0" radius="0.32" height="0.5" 
                      material="color: #999; metalness: 0.9; roughness: 0.2" 
                      rotation="15 5 0" shadow="cast: true">
             <a-ring position="0 -0.25 0" rotation="90 0 0" radius-inner="0.32" radius-outer="0.35" color="#777"></a-ring>
          </a-cylinder>

          <a-box position="0 -0.2 0.1" width="0.35" height="0.2" depth="0.3" color="#557a57"></a-box>
        </a-entity>

        <a-box position="0.35 1.4 0.3" width="0.1" height="0.1" depth="0.7" color="#6b8e6d" rotation="5 10 0"></a-box>
        <a-box position="-0.35 1.3 0.3" width="0.1" height="0.1" depth="0.7" color="#6b8e6d" rotation="-5 -10 0"></a-box>
      </a-entity>

    </a-scene>
  </body>
</html>
